<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_volume_detection" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.volume.detection</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Volume Detection" name="volume_logistic_detection">
                    <block title="Roboflow Model" name="vld_roboflow_settings">
                        <setting
                            string="Roboflow API Key"
                            help="Stored on the server only. Never sent to the browser.">
                            <field name="vld_roboflow_api_key" password="True"/>
                        </setting>
                        <setting string="Model ID" help="Project slug from Roboflow.">
                            <field name="vld_roboflow_model_id"/>
                        </setting>
                        <setting string="Model Version" help="Dataset version number.">
                            <field name="vld_roboflow_version"/>
                        </setting>
                        <setting
                            string="Minimum Confidence"
                            help="Detections below this confidence (0 to 1) are ignored.">
                            <field name="vld_confidence"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
